# Urban Water-logged AI Environment Configuration Template

# General
PROJECT_NAME="Urban Water-logged AI"
SECRET_KEY="replace-with-a-long-random-secret-before-deployment"
SIMULATION_MODE=true
CITY_NAME="Dhaka"

# Authentication (change every demo password before any shared deployment)
CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000"
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false
DEMO_CREDENTIALS_ENABLED=true
DEMO_CIVIC_PASSWORD="CivicDemo#2026"
DEMO_ANALYST_PASSWORD="AnalystDemo#2026"
DEMO_OPERATOR_PASSWORD="OperatorDemo#2026"
DEMO_ADMIN_PASSWORD="AdminDemo#2026"

# Database (Default: SQLite for zero-config hackathon demo; supports PostgreSQL with PostGIS)
DATABASE_URL="sqlite:///./urban_waterlogged_ai.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/urban_waterlogged_ai"

# Server
HOST="127.0.0.1"
PORT=8000
DEBUG=false

# Priority Weights (MCDA Decision Matrix)
WEIGHT_SEVERITY=0.30
WEIGHT_CRITICAL_INFRA=0.25
WEIGHT_POPULATION=0.15
WEIGHT_RISE_RATE=0.10
WEIGHT_DURATION=0.10
WEIGHT_ROAD_IMPORTANCE=0.10

# Pump Safety Interlocks
SAFE_DESTINATION_DRAIN_CAPACITY_MIN_PERCENT=15.0
MOTOR_OVERHEAT_THRESHOLD_C=85.0
COMMAND_EXPIRY_SECONDS=300

# Gemini AI (Advisory-only multimodal analysis; backend environment only)
GEMINI_API_KEY=

